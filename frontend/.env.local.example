# Contextly frontend env — copy to frontend/.env.local (or set at container build time).

# Backend base URL consumed by the API client (docs/local-dev.md §3)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Auth mode: dev (zero credentials, docs/local-dev.md §3) | supabase
NEXT_PUBLIC_AUTH_MODE=dev

# Dev-mode JWT signing secret — must match backend DEV_JWT_SECRET
# (well-known dev default; backend refuses AUTH_MODE=dev outside APP_ENV=dev)
NEXT_PUBLIC_DEV_JWT_SECRET=contextly-dev-secret-0123456789abcdef

# Supabase Auth (only for NEXT_PUBLIC_AUTH_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=