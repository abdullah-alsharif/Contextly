# Contextly dev environment (dev-safe defaults — no secrets, ever).
# Copy to .env: cp .env.example .env

# Postgres (compose `db` service). Sync psycopg driver (Phase 0 migrations runner).
DATABASE_URL=postgresql://contextly:contextly@db:5432/contextly

# AI provider: fake (dev) | nvidia | openrouter
AI_PROVIDER=fake

# Embeddings (docs/rag.md §2: bge-m3 1024d; docs/ai-providers.md §2)
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
AI_EMBED_RETRIES=3
AI_EMBED_RETRY_BACKOFF_SECONDS=1,2,4

# NVIDIA NIM Build embeddings (only for AI_PROVIDER=nvidia; backend only)
NVIDIA_API_KEY=
NVIDIA_EMBEDDINGS_URL=https://integrate.api.nvidia.com/v1/embeddings

# OpenRouter embeddings (only for AI_PROVIDER=openrouter; backend only)
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings

# Storage provider: local (dev) | supabase
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/data/storage

# Storage tuning (docs/security.md §3: 10 MB upload cap)
STORAGE_BUCKET=documents
UPLOAD_MAX_BYTES=10485760

# Supabase Storage service role (only for STORAGE_PROVIDER=supabase; backend only)
SUPABASE_SERVICE_ROLE_KEY=

# Auth mode: dev (no credentials) | supabase
AUTH_MODE=dev

# Environment: dev | test | production (guards AUTH_MODE=dev)
APP_ENV=dev

# Dev-mode JWT signing secret (well-known in dev; overridable for tests)
DEV_JWT_SECRET=contextly-dev-secret-0123456789abcdef

# Supabase JWT verification (only for AUTH_MODE=supabase)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
JWT_LEEWAY_SECONDS=30

# CORS allowlist for the backend (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Document processing worker (docs/ingestion.md §3)
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_SECONDS=300
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=1,5,30

# Chunking defaults (docs/ingestion.md §4.3, docs/rag.md §3)
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Retrieval defaults (docs/rag.md §2; docs/security.md §4)
RETRIEVAL_TOP_K=6
RETRIEVAL_EF_SEARCH=40
RAG_QUERY_MAX_CHARS=4000

# Rate limiting — distinct in-process per-user buckets (docs/security.md §5:
# 30 req/min chat, 120 req/min general; 429 + Retry-After on overflow).
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Signed download URLs (docs/api.md §5 "5 min", docs/multi-tenancy.md §4)
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Frontend: backend base URL used by the API client
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
